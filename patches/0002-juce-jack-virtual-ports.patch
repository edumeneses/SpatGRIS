+//==============================================================================
+/* A synthetic JACK device that exposes an arbitrary number of ports.
+
+   Stock JUCE derives a device's channel count from the port count of whichever
+   *other* JACK client is selected (JackAudioIODeviceType::scanForDevices plus
+   JackAudioIODevice::getChannelNames), so there is no way to ask for "N ports,
+   connected to nothing". Set JUCE_JACK_VIRTUAL_INPUTS and/or
+   JUCE_JACK_VIRTUAL_OUTPUTS and an extra device appears in the device lists;
+   choosing it registers exactly that many ports, connects none of them, and
+   reports them all as active, so the host sees a stable channel count while the
+   graph is patched by hand (pw-link, qpwgraph, ...).
+
+   Linux/BSD only. Everywhere else the counts are always zero, the device never
+   appears, and behaviour is byte-for-byte upstream JUCE.
+*/
+namespace JackVirtualDevice
+{
+    static const char* const deviceName = "Virtual ports (patch manually)";
+
+   #if JUCE_LINUX || JUCE_BSD
+    static int countFromEnv (const char* varName)
+    {
+        const auto value = SystemStats::getEnvironmentVariable (varName, {}).trim();
+
+        if (value.isNotEmpty())
+        {
+            const auto n = value.getIntValue();
+
+            // Capped far below jack.max-client-ports (768 by default in
+            // pipewire-jack) so a typo cannot exhaust the server port table.
+            if (n > 0)
+                return jmin (n, 512);
+        }
+
+        return 0;
+    }
+
+    static int numInputs()   { return countFromEnv ("JUCE_JACK_VIRTUAL_INPUTS"); }
+    static int numOutputs()  { return countFromEnv ("JUCE_JACK_VIRTUAL_OUTPUTS"); }
+   #else
+    static int numInputs()   { return 0; }
+    static int numOutputs()  { return 0; }
+   #endif
+
+    static bool isVirtual (const String& name)  { return name == deviceName; }
+}
+
